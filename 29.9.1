#include<stdio.h>
#include<conio.h>
#include<stdbool.h>
#include<stdlib.h>
void main()
{


int size = 20;
int stack[size];
int val,c,top=-1;
bool a = true;

while(a)
{
    printf("\nEnter your choice \n1.Push 2.Pop 3.Display 4. quit\n");
    scanf("%d",&c);
    switch(c)
        {
        case 1 :
            {
                if (top == size-1)
                    printf("Stack overloaded\n");
                else
                {
                    printf("Enter value : ");
                    scanf("%d",&val);
                    top=top+1;
                    stack[top]=val;
                break
                
                }
            }
        case 2 :
            {
                if (top == -1)
                    printf("Stack underloaded\n");
                else
                {
                    top=top-1;
                    size=size-1;
                }
                break;
            }
        case 3 :
            for(int i=top;i>=0;i--)
                printf("%d ",stack[i]);
            break;
        case 4 :
            a= false;
            break;

        default :
            printf("Enter a valid option");

        }
}
}
