#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <string.h>

char stack[50];
int top = -1;

void push(char val)
{
    stack[++top] = val;
}

char pop()
{
    return stack[top--];
}

int pr(char op)
{
    if (op == '^')
        return 3;
    else if (op == '*' || op == '/')
        return 2;
    else if (op == '+' || op == '-')
        return 1;
    else if (op == '#')
        return 0;

    return -1;
}

int main()
{
    char infix[50], postfix[50], ch;
    int i = 0, k = 0;

    printf("Enter infix expression: ");
    fgets(infix, sizeof(infix), stdin);

    infix[strcspn(infix, "\n")] = '\0';

    push('#');

    while ((ch = infix[i++]) != '\0')
    {
        if (isalnum(ch))
        {
            postfix[k++] = ch;
        }
        else if (ch == '(')
        {
            push(ch);
        }
        else if (ch == ')')
        {
            while (stack[top] != '(')
                postfix[k++] = pop();

            pop();
        }
        else
        {
            while (stack[top] != '#' &&
                   pr(stack[top]) >= pr(ch))
            {
                postfix[k++] = pop();
            }

            push(ch);
        }
    }

    while (stack[top] != '#')
        postfix[k++] = pop();

    postfix[k] = '\0';

    printf("The postfix string is: %s\n", postfix);

    return 0;
}
